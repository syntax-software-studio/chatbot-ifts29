{
  "name": "@ifts29/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API Express + TypeScript del Asistente Virtual IFTS N.29 (Vercel Serverless).",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "db:push": "tsx src/db/push.ts",
    "sync": "tsx src/db/sincronizar.ts",
    "casos:generar": "tsx test/casos/generar-casos.ts",
    "casos:evaluar": "tsx test/casos/evaluar-casos.ts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
