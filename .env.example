# ==========================================================
# Asistente Virtual IFTS N.29 - Variables de entorno
# Copiar a `.env` (en la raiz del repo) y completar.
# NUNOMENTAR este archivo con secretos.
#
# Un solo archivo para todo el proyecto: el backend lo lee al arrancar y el
# build del frontend toma de aqui las variables `VITE_*`. Si no existe, todo
# funciona con los defaults y la API cae en modo semilla (catalogo local).
# En Vercel NO se despliega: cargar las mismas variables en
# Project Settings -> Environment Variables.
# ==========================================================

# ---------- Frontend (build-time, Vite) ----------
# URL base de la API. Vacio = mismo origen (recomendado en Vercel).
VITE_API_BASE_URL=
# Datos institutionales mostrados en el header
VITE_INSTITUTO_NOMBRE=IFTS N°29
VITE_INSTITUTO_SUBTITULO=En linea
# Orígenes permitidos a embeber el widget (separados por coma).
# Debe incluir el dominio del Moodle institucional y el propio.
VITE_ALLOWED_ORIGINS=https://aulasvirtuales.bue.edu.ar,https://chatbot-ifts29.vercel.app
# Doble clic para abrir el widget y mostrar "Powered by"
VITE_WIDGET_DEBUG=false

# ---------- Backend / PostgreSQL (Neon o Docker local) ----------
# Conexion PostgreSQL estandar, con driver `pg`. La misma variable sirve para
# Neon (Connection Details > Pooled connection, con ?sslmode=require) y para el
# Postgres de Docker: postgresql://postgres:password123@localhost:5432/ifts29
# El nombre de la base es el ultimo segmento de la URL (este proyecto usa
# "ifts29"), pero la aplicacion no lo necesita: solo lee esta variable.
# Si se deja vacio, la API usa el catalogo semilla local (modo demo)
# y no requiere base de datos.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.neon.tech/ifts29?sslmode=require

# ---------- Google Drive (Service Account, solo lectura) ----------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHARED_FOLDER_ID=
# ID de la planilla "Bot IFTS29 - Contenido" (la parte entre /d/ y /edit de su URL).
# La cuenta de servicio debe tener acceso de Lector a la planilla. Lectura solo.
GOOGLE_SHEET_ID=
# Intentar crear el permiso "cualquiera con el enlace" en cada archivo.
# Es una ESCRITURA en Drive: con el alcance solo lectura (drive.readonly) la API
# responde 403 y el bot continua con el enlace canonico. Dejar en false salvo
# que la carpeta institutional ya se comparta publicamente por otra via.
DRIVE_PUBLIC_LINKS=false
# Prefijo de cache (segundos) para el enlace de Drive
DRIVE_LINK_CACHE_TTL=3600

# ---------- API ----------
NODE_ENV=production
PORT=3000
# Secret compartido para proteger POST /api/sync (opcional en demo)
SYNC_SECRET=
# Limite de peticiones por IP y ventana (rate limit)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Origenes permitidos por CORS, separados por coma.
# Si se deja vacio usa VITE_ALLOWED_ORIGINS.
CORS_ORIGINS=
# Dominios que pueden embeber el widget (iframe frame-ancestors)
IFRAME_ANCESTORS=https://aulasvirtuales.bue.edu.ar,https://chatbot-ifts29.vercel.app

# ---------- Consultas escritas (lenguaje natural controlado) ----------
# Los valores por defecto ya funcionan: se documentan para poder calibrarlos con
# consultas reales, no son constantes de negocio. El mismo motor corre en demo
# (catalogo local) y en Neon, asi que un cambio aqui se refleja en ambos.
# Largo minimo y maximo del mensaje escrito por el estudiante.
KB_MIN_MENSAJE=2
KB_MAX_MENSAJE=800
# >= KB_UMBRAL_ALTO: se responde con la opcion del menu equivalente.
# >= KB_UMBRAL_MEDIO (y por debajo del alto): se pide aclaracion.
# Por debajo de KB_UMBRAL_MEDIO: se informa que no hay informacion disponible.
KB_UMBRAL_ALTO=0.90
KB_UMBRAL_MEDIO=0.70
# Dos intenciones con menos diferencia que esto se consideran empatadas y se
# pregunta, en lugar de elegir una al azar.
KB_MARGEN_AMBIGUEDAD=0.05
# Maximo de opciones mostradas en una aclaracion.
KB_MAX_OPCIONES_ACLARACION=4
